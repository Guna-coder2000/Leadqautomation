# Email Reporting Configuration
# Copy this file to '.env' and fill in your actual credentials.
# DO NOT commit '.env' to version control!

# Enable or disable email reporting (true/false)
SEND_EMAIL_REPORT=true

# SMTP Server details (For Gmail: smtp.gmail.com, Port: 465, Secure: true)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Your email address and App Password (NOT your regular login password!)
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# Recipients (comma-separated if multiple)
EMAIL_TO=gunasekhar.puttu@forgebyte.ai, team@company.com
